# ROADNET Distribution Dashboard - Environment Configuration
# This file is a template. Copy to .env.local and fill with actual values.
# NEVER commit .env.local with real credentials to git!
#
# For Vercel deployment: Add these variables to Project Settings > Environment Variables
# with the appropriate values for your production environment.

# ============================================================================
# REQUIRED: ROADNET API Configuration
# ============================================================================
# ROADNET API Base URL (public, can be shared)
NEXT_PUBLIC_API_BASE_URL=https://apex-prod-eu-integration.eu.roadnet.com/integration

# ROADNET credentials are entered on the login screen at runtime and are
# never stored in code or env vars.

# ============================================================================
# CRITICAL: Security - CSRF Token Secret
# ============================================================================
# MUST be set in production. Generate with: openssl rand -hex 32
# DO NOT use the same secret across multiple deployments
CSRF_SECRET=your-32-character-hex-secret-here

# ============================================================================
# CRITICAL: Distributed Rate Limiting (Upstash Redis)
# ============================================================================
# Required for production with multiple instances or serverless
# Sign up at: https://upstash.com (free tier includes 10,000 commands/day)
#
# Only needed if using Upstash. Omit both if using in-memory rate limiting
# (in-memory is NOT recommended for production with multiple instances)
UPSTASH_REDIS_REST_URL=https://YOUR_REDIS_NAME.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_REDIS_REST_TOKEN

# ============================================================================
# OPTIONAL: Airtable Integration (for address verification)
# ============================================================================
# Only required if using the address verification feature
AIRTABLE_TOKEN=pat_YOUR_AIRTABLE_TOKEN
AIRTABLE_BASE_ID=appYOUR_BASE_ID
AIRTABLE_TABLE_ID=tblYOUR_TABLE_ID

# ============================================================================
# OPTIONAL: Security Settings
# ============================================================================
# Force HTTPS for secure cookies (defaults to true in production)
# Set to 'true' if running on HTTPS, 'false' only in local development
FORCE_HTTPS=true
