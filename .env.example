# ROADNET API Configuration
# This file is a template. Copy to .env.local and fill with actual values.
# NEVER commit .env.local with real credentials to git!

# ROADNET API Base URL
NEXT_PUBLIC_API_BASE_URL=https://apex-prod-eu-integration.eu.roadnet.com/integration

# ROADNET API Credentials
# ⚠️ CRITICAL: Use a secure secrets manager in production!
# Options: AWS Secrets Manager, HashiCorp Vault, GitHub Secrets, etc.
ROADNET_API_USERNAME=your-api-email@example.com
ROADNET_API_PASSWORD=your-secure-password-here

# Security: CSRF Token Secret (generate with: openssl rand -hex 32)
CSRF_SECRET=your-32-char-hex-secret

# Security: Force HTTPS in development (set to 'true' for secure cookies)
# FORCE_HTTPS=false
