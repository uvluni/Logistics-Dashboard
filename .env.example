# ROADNET API Configuration
# Copy this file to .env.local and fill in with your actual credentials
# IMPORTANT: Never commit .env.local to version control!

NEXT_PUBLIC_API_BASE_URL=https://apex-prod-eu-integration.eu.roadnet.com/integration
ROADNET_API_USERNAME=your_api_username_here
ROADNET_API_PASSWORD=your_api_password_here
