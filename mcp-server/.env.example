# ROADNET API Configuration
# Base URL, WITHOUT /v1 (the client adds it per-request)
RNA_API_BASE_URL=https://apex-prod-eu-integration.eu.roadnet.com/integration

# ROADNET web services credentials
# Get these from your ROADNET Anywhere API account (same username/password you use to log in)
# Example: roadnet@connector.co.il / your-password
RNA_API_USERNAME=your-username@example.com
RNA_API_PASSWORD=your-password-here

# Default length of a normal work day in minutes
# Used for KPI calculations when not specified in requests
# Default: 540 (9 hours)
RNA_NORMAL_WORKDAY_MINUTES=540
